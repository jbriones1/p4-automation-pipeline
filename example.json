{
  "cna_version": "0.4",
  "name": "ethernet_ipv4_tcp_udp",
  "consts": [
    { "field": "IPV4_ETHTYPE", "bit_width": "16", "value": "0x800"},
    { "field": "UDP_PROTO", "bit_width": "16", "value": 17},
    { "field": "TCP_PROTO", "bit_width": "16", "value": 6}
  ],
  "typedefs": [
    { "field": "macAddr_t", "bit_width": 48 },
    { "field": "ip4Addr_t", "bit_width": 32 },
    { "field": "etherType_t", "bit_width": 16 },
    { "field": "port_t", "bit_width": 9 },
    { "field": "l4Port_t", "bit_width": 16 }
  ],
  "protocols": [
    {
      "id": "tcp",
      "headers": [
        { "field": "src_port", "type": "l4Port_t" },
        { "field": "dst_port", "type": "l4Port_t" },
        { "field": "seq_no", "bit_width": 32 },
        { "field": "ack_no", "bit_width": 32 },
        { "field": "data_off", "bit_width": 4 },
        { "field": "res", "bit_width": 4 },
        { "field": "flags", "bit_width": 8 },
        { "field": "window", "bit_width": 16 },
        { "field": "checksum", "bit_width": 16 },
        { "field": "urg_ptr", "bit_width": 16 }
      ]
    },
    {
      "id": "udp",
      "headers": [
        { "field": "src_port", "type": "l4Port_t" },
        { "field": "dst_port", "type": "l4Port_t" },
        { "field": "length", "bit_width": 16 },
        { "field": "checksum", "bit_width": 16 }
      ]
    }
  ],
  "networks": [
    {
      "id": "ethernet",
      "namespace": {
        "member_id_type": "macAddr_t"
      },
      "forwarding_header": [
        { "field": "dst_addr", "type": "macAddr_t" },
        { "field": "src_addr", "type": "macAddr_t" },
        { "field": "ether_type", "type": "etherType_t" }
      ],
      "session_protocols": []
    },
    {
      "id": "ipv4",
      "namespace": {
        "member_id_type": "ip4Addr_t"
      },
      "forwarding_header": [
        { "field": "version", "bit_width": 4 },
        { "field": "ihl", "bit_width": 4 },
        { "field": "diffserv", "bit_width": 8 },
        { "field": "total_len", "bit_width": 16 },
        { "field": "identification", "bit_width": 16 },
        { "field": "flags", "bit_width": 3 },
        { "field": "frag_offset", "bit_width": 13 },
        { "field": "ttl", "bit_width": 8 },
        { "field": "protocol", "bit_width": 8 },
        { "field": "hdr_checksum", "bit_width": 16 },
        { "field": "src_addr", "type": "ip4Addr_t" },
        { "field": "dst_addr", "type": "ip4Addr_t" }
      ],
      "session_protocols": [
        {
          "protocol": "tcp",
          "indicator_field": "ipv4.protocol",
          "indicator_value": "TCP_PROTO"
        },
        {
          "protocol": "udp",
          "indicator_field": "ipv4.protocol",
          "indicator_value": "UDP_PROTO"
        }
      ]
    },
    {
      "id": "ipv4_2",
      "namespace": {
        "member_id_type": "ip4Addr_t"
      },
      "forwarding_header": [
        { "field": "version", "bit_width": 4 },
        { "field": "ihl", "bit_width": 4 },
        { "field": "diffserv", "bit_width": 8 },
        { "field": "total_len", "bit_width": 16 },
        { "field": "identification", "bit_width": 16 },
        { "field": "flags", "bit_width": 3 },
        { "field": "frag_offset", "bit_width": 13 },
        { "field": "ttl", "bit_width": 8 },
        { "field": "protocol", "bit_width": 8 },
        { "field": "hdr_checksum", "bit_width": 16 },
        { "field": "src_addr", "type": "ip4Addr_t" },
        { "field": "dst_addr", "type": "ip4Addr_t" }
      ],
      "session_protocols": [
        {
          "protocol": "tcp",
          "indicator_field": "ipv4.protocol",
          "indicator_value": "TCP_PROTO"
        },
        {
          "protocol": "udp",
          "indicator_field": "ipv4.protocol",
          "indicator_value": "UDP_PROTO"
        }
      ]
    }
  ],
  "composition": [
    {
      "operator": "layering",
      "overlay": "ipv4_2",
      "underlay": "ethernet",
      "encapsulation": {
        "indicator_field": "ethernet.ether_type",
        "indicator_value": "IPV4_ETHTYPE"
      },
      "forwarding_actions": [
        {
          "id": "ipv4_forward",
          "parameters": [
            { "name": "dst_mac", "type": "macAddr_t" },
            { "name": "src_mac", "type": "macAddr_t" },
            { "name": "egress_port", "type": "port_t" }
          ],
          "operations": [
            {
              "op": "set_field",
              "target": "ethernet.dst_addr",
              "value": { "from_param": "dst_mac" }
            },
            {
              "op": "set_field",
              "target": "ethernet.src_addr",
              "value": { "from_param": "src_mac" }
            },
            { "op": "decrement", "target": "ipv4.ttl", "amount": 1 },
            {
              "op": "set_egress_port",
              "value": { "from_param": "egress_port" }
            }
          ]
        },
        {
          "id": "drop",
          "parameters": [],
          "operations": [{ "op": "drop" }]
        }
      ]
    }
  ],
  "services": [
    {
      "id": "nat",
      "network": "ipv4_2",
      "actions": [
        {
          "id": "nat_rewrite_src",
          "parameters": [
            { "name": "new_src_addr", "type": "ip4Addr_t" },
            { "name": "new_src_port", "type": "l4Port_t" }
          ],
          "operations": [
            {
              "op": "set_field",
              "target": "ipv4.src_addr",
              "value": { "from_param": "new_src_addr" }
            },
            {
              "op": "set_field",
              "target": "tcp.src_port",
              "value": { "from_param": "new_src_port" }
            }
          ]
        },
        {
          "id": "nat_rewrite_dst",
          "parameters": [
            { "name": "orig_dst_addr", "type": "ip4Addr_t" },
            { "name": "orig_dst_port", "type": "l4Port_t" }
          ],
          "operations": [
            {
              "op": "set_field",
              "target": "ipv4.dst_addr",
              "value": { "from_param": "orig_dst_addr" }
            },
            {
              "op": "set_field",
              "target": "tcp.dst_port",
              "value": { "from_param": "orig_dst_port" }
            }
          ]
        }
      ]
    }
  ]
}
